        return threats
    
    @classmethod
    def _get_threat_severity(cls, threat_type: str) -> int:
        """Get severity score for each threat type"""
        severity_map = {
            'sql_injection': 95,
            'xss_attempt': 90,
            'command_injection': 95,
            'path_traversal': 85,
            'spam_indicators': 40,
            'suspicious_urls': 60,
            'phone_exposure': 30,
            'email_exposure': 25,
            'profanity': 20,
            'suspicious_pricing': 35,
            'fake_urgency': 30
        }
