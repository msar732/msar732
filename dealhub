    def advanced_threat_detection(cls, text: str, context: str = "general") -> dict:
        """Advanced threat detection with ML-enhanced scoring"""
        threats = {
            'detected_threats': [],
            'risk_score': 0,
            'confidence': 0,
            'action_required': 'none',  # none, review, block
            'recommendations': []
        }
        
