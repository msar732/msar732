        function handleCategoryFileSelect(e) {
            const files = Array.from(e.target.files);
            handleCategoryFiles(files);
        }

        function handleCategoryFiles(files) {
            const validFiles = files.filter(file => {
                const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
                const maxSize = 5 * 1024 * 1024; // 5MB
                
                if (!validTypes.includes(file.type)) {
                    showMessage('categoryUploadMessage', `${file.name} is not a valid image type`, 'error');
                    return false;
                }
                
                if (file.size > maxSize) {
                    showMessage('categoryUploadMessage', `${file.name} is too large (max 5MB)`, 'error');
                    return false;
                }
                
                return true;
            });

            if (categoryUploadedPhotos.length + validFiles.length > 5) {
                showMessage('categoryUploadMessage', 'Maximum 5 photos allowed', 'error');
                return;
            }

            validFiles.forEach(file => {
                const reader = new FileReader();
                reader.onload = (e) => {
                    categoryUploadedPhotos.push({
                        file: file,
                        preview: e.target.result
                    });
                    updateCategoryPhotoPreview();
                };
                reader.readAsDataURL(file);
            });
        }

        function updateCategoryPhotoPreview() {
            const previewGrid = document.getElementById('categoryPhotoPreviewGrid');
            const uploadArea = document.getElementById('categoryPhotoUploadArea');

            if (categoryUploadedPhotos.length === 0) {
                previewGrid.style.display = 'none';
                uploadArea.style.display = 'block';
                return;
            }

            previewGrid.style.display = 'grid';
            previewGrid.innerHTML = '';

            categoryUploadedPhotos.forEach((photo, index) => {
                const photoItem = document.createElement('div');
                photoItem.className = 'photo-preview-item';
                photoItem.innerHTML = `
                    <img src="${photo.preview}" alt="Preview">
                    <button type="button" class="remove-photo" onclick="removeCategoryPhoto(${index})">
                        <i class="fas fa-times"></i>
                    </button>
                `;
                previewGrid.appendChild(photoItem);
            });

            if (categoryUploadedPhotos.length >= 5) {
                uploadArea.style.display = 'none';
            } else {
                uploadArea.style.display = 'block';
            }
        }

        function removeCategoryPhoto(index) {
