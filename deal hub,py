# --- Utilities ---
def safe_float(value: Any, default: float = 0.0) -> float:
    try:
        return float(value)
    except Exception:
        return default


def clamp(value: float, low: float, high: float) -> float:
    return max(low, min(high, value))


# --- Motor Price Predictor ---
class MotorPricePredictor:
    """Lightweight predictor with optional sklearn model fallback.

    If a joblib model is found under ai_models/motor_price_model.pkl, it will be
    loaded and used. Otherwise, a heuristic predictor is used.
    """

    def __init__(self) -> None:
        self.model: Any = None
        self._load_models_if_available()

    # Files can be optionally placed under ./ai_models
    MODEL_PATH = os.path.join("ai_models", "motor_price_model.pkl")

    def _load_models_if_available(self) -> None:
        if joblib is None or RandomForestRegressor is None:
            self.model = None
            return
        try:
            if os.path.exists(self.MODEL_PATH):
                self.model = joblib.load(self.MODEL_PATH)
            else:
                # Initialize an empty RF; without training it's unused
                self.model = RandomForestRegressor(n_estimators=50, random_state=42)
        except Exception:
            self.model = None

    def analyze_listing(self, listing: MotorListing) -> Dict[str, Any]:
        features = self._extract_features(listing)

        predicted_price = self._predict_price(features, listing)
        market_position = self._determine_market_position(listing.price, predicted_price)

        return {
            "predicted_price": round(predicted_price, 2),
            "market_position": market_position,
            "price_trend": self._get_price_trend(listing),
            "similar_avg": self._get_similar_listings_avg(listing),
        }

    def _extract_features(self, listing: MotorListing) -> List[float]:
        title_len = len(listing.title.split()) if listing.title else 0
        is_petrol = 1.0 if listing.fuel_type == "petrol" else 0.0
        is_automatic = 1.0 if listing.transmission == "automatic" else 0.0
        is_excellent = 1.0 if listing.condition == "excellent" else 0.0
        return [
            float(listing.year or 0),
            float(listing.mileage or 0),
            float(listing.engine_size or 1.0),
            float(title_len),
            is_petrol,
            is_automatic,
            float(listing.doors or 4),
            is_excellent,
        ]

    def _predict_price(self, features: Sequence[float], listing: MotorListing) -> float:
        # If we have a trained sklearn model, use it
        if self.model is not None and hasattr(self.model, "predict"):
            try:
                # Convert to 2D for sklearn, support numpy if available
                if np is not None:
                    arr = np.array(features, dtype=float).reshape(1, -1)
                else:
                    arr = [list(map(float, features))]
                pred = self.model.predict(arr)[0]
                if math.isfinite(safe_float(pred)):
                    return safe_float(pred)
            except Exception:
                pass

        # Heuristic fallback
        current_year = time.gmtime().tm_year
        vehicle_age = max(0, current_year - int(listing.year)) if listing.year else 10
        base_price = 500000.0  # base anchor in INR

        # Depreciation: ~8% per year up to 15 years
        depreciation_years = clamp(float(vehicle_age), 0.0, 15.0)
        price_after_age = base_price * ((1.0 - 0.08) ** depreciation_years)

        # Mileage adjustment: assume 1% drop per 10,000 km beyond 20,000 km
        mileage = float(listing.mileage or 0)
        extra_tenks = max(0.0, (mileage - 20000.0) / 10000.0)
        price_after_mileage = price_after_age * (1.0 - 0.01 * extra_tenks)

        # Engine size adds premium
        engine_size = float(listing.engine_size or 1.2)
        engine_factor = 1.0 + clamp((engine_size - 1.2) * 0.15, -0.2, 0.6)
        price_after_engine = price_after_mileage * engine_factor

        # Transmission premium
        transmission_factor = 1.05 if listing.transmission == "automatic" else 1.0
        price_after_transmission = price_after_engine * transmission_factor

        # Condition factor
        condition_map = {
            "new": 1.25,
            "excellent": 1.15,
            "very_good": 1.10,
            "good": 1.0,
            "fair": 0.9,
            "poor": 0.8,
            "damaged": 0.6,
        }
        condition_factor = condition_map.get(listing.condition, 1.0)

        predicted = price_after_transmission * condition_factor
        # Never return negative or NaN
        return max(10000.0, float(predicted) if math.isfinite(float(predicted)) else 10000.0)

    def _determine_market_position(self, actual_price: float, predicted_price: float) -> str:
        predicted = safe_float(predicted_price, default=1.0) or 1.0
        ratio = safe_float(actual_price) / predicted
        if ratio > 1.15:
            return "above_market"
        if ratio < 0.85:
            return "below_market"
        return "market_average"

    def _get_price_trend(self, listing: MotorListing) -> str:
        # Placeholder: could analyze recent similar vehicles
        return "stable"

    def _get_similar_listings_avg(self, listing: MotorListing) -> float:
        similar = [
            l for l in DB.motor_listings
            if l.status == "active"
            and l.make == listing.make
            and abs((l.year or 0) - (listing.year or 0)) <= 2
            and l.id != listing.id
        ]
        if not similar:
            return float(listing.price)
        avg = sum(safe_float(l.price) for l in similar) / max(1, len(similar))
        return float(avg)


# --- Recommendation Engine ---
class RecommendationEngine:
    def get_user_recommendations(self, user: User, limit: int = 10) -> List[Listing]:
        cache_key = f"recs:{user.id}:{limit}"
        cached = cache.get(cache_key)
        if cached is not None:
            return cached

        interactions = self._get_user_interactions(user)
        content_recs = self._content_based(interactions, limit // 2)
        collab_recs = self._collaborative(user, limit // 2)

        # Combine while preserving order, de-dup by id
        combined: List[Listing] = []
        seen: set[int] = set()
        for item in content_recs + collab_recs:
            if item.id not in seen:
                combined.append(item)
                seen.add(item.id)
            if len(combined) >= limit:
                break

        cache.set(cache_key, combined, ttl_seconds=3600)
        return combined

    def _get_user_interactions(self, user: User) -> Dict[str, Any]:
        # Use favorites as proxy for preferences
        fav_listing_ids = {f.listing_id for f in DB.favorites if f.user_id == user.id}
        fav_listings = [l for l in DB.listings if l.id in fav_listing_ids]

        if not fav_listings:
            # Fallback to user's area preferences only
            return {
                "price_range": (0.0, float("inf")),
                "states": [user.state] if user.state else [],
                "districts": [user.district] if user.district else [],
            }

        prices = [safe_float(l.price) for l in fav_listings]
        min_p = max(0.0, min(prices) * 0.7) if prices else 0.0
        max_p = max(prices) * 1.3 if prices else float("inf")

        states = {l.state for l in fav_listings if l.state}
        districts = {l.district for l in fav_listings if l.district}

        return {
            "price_range": (min_p, max_p),
            "states": list(states) or ([user.state] if user.state else []),
            "districts": list(districts) or ([user.district] if user.district else []),
        }

    def _content_based(self, prefs: Dict[str, Any], limit: int) -> List[Listing]:
        if limit <= 0:
            return []
        pr_min, pr_max = prefs.get("price_range", (0.0, float("inf")))
        states = set(prefs.get("states", []))
        districts = set(prefs.get("districts", []))

        def matches(l: Listing) -> bool:
            if l.status != "active":
                return False
            price = safe_float(l.price)
            if price < pr_min or price > pr_max:
                return False
            if states and l.state and l.state not in states:
                return False
            if districts and l.district and l.district not in districts:
                return False
            return True

        results: List[Listing] = [l for l in DB.listings if matches(l)]
        return results[:limit]

    def _collaborative(self, user: User, limit: int) -> List[Listing]:
        if limit <= 0:
            return []
        # Simple collaborative idea: users in same state tend to like similar items
        similar_users = [u for u in DB.users if u.id != user.id and u.state == user.state]
        similar_user_ids = {u.id for u in similar_users}
        similar_favs = {f.listing_id for f in DB.favorites if f.user_id in similar_user_ids}

        candidates = [l for l in DB.listings if l.id in similar_favs and l.status == "active"]
        # Prefer mid-priced items to avoid extremes
        candidates.sort(key=lambda l: safe_float(l.price))
        return candidates[:limit]


